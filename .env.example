# ===== PRODUCTION (live Microsoft 365 workbook) =====
SOURCE=graph
PUBLIC_BASE_URL=https://staff.yourcompany.example        # must be HTTPS and reachable by Microsoft (webhooks)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=                                      # keep in a secrets manager, never in git
GRAPH_DRIVE_ID=
GRAPH_ITEM_ID=
GRAPH_FILE_SCOPE=Files.ReadWrite                          # use Files.ReadWrite.All only if the file is in SharePoint / shared
SESSION_SECRET=                                           # python -c "import secrets;print(secrets.token_urlsafe(48))"
TOKEN_ENCRYPTION_KEY=                                     # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
WEBHOOK_CLIENT_STATE=                                     # python -c "import secrets;print(secrets.token_urlsafe(32))"
ROLE_ADMINS=you@company.com
ROLE_EDITORS=
ROLE_VIEWERS=
SYNC_INTERVAL_SECONDS=30
DATA_DIR=/var/lib/staff-manager

# ===== LOCAL TEST (isolated COPY of the workbook - NOT live) =====
# SOURCE=local
# LOCAL_WORKBOOK_PATH=/path/to/COPY-of-workbook.xlsx
# DEV_AUTH=1
